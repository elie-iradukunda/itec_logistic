# Copy this file to .env and fill in the real values.
# .env is ignored by git: secrets stay on the machine that runs the app.

LOGISTICS_DB_HOST=127.0.0.1
LOGISTICS_DB_NAME=logistics_mvc
LOGISTICS_DB_USER=root
LOGISTICS_DB_PASS=
LOGISTICS_BASE_URL=/logistics-mvc

# The public address of this installation, used for links inside emails.
APP_URL=http://localhost/logistics-mvc

# ---------------------------------------------------------------- email
# Resend (https://resend.com). Without a key the system still records every
# message it meant to send, in Administration > Email outbox, and sends none.
RESEND_API_KEY=
SMTP_FROM_EMAIL=lms@updates.itec.rw
SMTP_FROM_NAME=ITEC Ltd
INITIAL_REPLY_TO=

# While testing, send every message to one address instead of to real people.
# Leave blank in production.
MAIL_REDIRECT_ALL_TO=
